// OBLinux Fastfetch config (docs/THEMING.md item 6; Brand Master Phase 2C).
//
// System-wide default — /etc/xdg/fastfetch/ is a real, verified fastfetch
// config search path (confirmed against its own source,
// src/common/impl/FFPlatform_unix.c's getConfigDirs(), which checks
// $XDG_CONFIG_HOME, then $XDG_CONFIG_DIRS, then /etc/xdg/, then /etc/
// directly). Applies to liveuser and any Calamares-created account with
// no per-user setup needed, same pattern as the icon theme and shell
// theme. A user's own ~/.config/fastfetch/config.jsonc still takes
// priority over this if they create one.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        // Shared, generated R5 artwork copied byte-for-byte from Brand Master.
        // ANSI truecolor matches Brand Master's portable configuration and the
        // known-good Debian implementation.
        "source": "/usr/share/oblinux/terminal/fastfetch/logo.txt",
        "color": {
            "1": "38;2;30;77;140",
            "2": "38;2;255;138;0"
        },
        "padding": { "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;30;77;140",
            "title": "38;2;30;77;140",
            "output": "default",
            "separator": "default"
        },
        "key": { "width": 12 }
    },
    // Short, curated list -- same "deliberate defaults over an
    // overwhelming dump" philosophy as the package-list phase. Dropped
    // vs. the traditional neofetch-style full set: resolution, DE, WM,
    // GTK/icon theme, terminal font -- all either GNOME-specific and
    // unchanging on OBLinux (always the same desktop, so "DE: GNOME"
    // etc. add nothing fetch to fetch) or genuinely niche.
    "modules": [
        "title",
        "separator",
        "os",
        {
            "type": "kernel",
            "format": "{release}"
        },
        "uptime",
        {
            "type": "packages",
            "combined": true
        },
        "shell",
        "terminal",
        "cpu",
        {
            "type": "gpu",
            "format": "{name}"
        },
        {
            "type": "memory",
            "format": "{used} / {total}"
        },
        "break",
        "colors"
    ]
}
