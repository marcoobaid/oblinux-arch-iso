/*
 * OBLinux live session only: let the designated live user start Calamares
 * through its own pkexec action without an otherwise-empty authentication
 * prompt. The installer still runs elevated; no other action or executable
 * is authorized by this rule.
 *
 * Calamares' shellprocess-final cleanup removes this file from the target
 * system because unpackfs initially copies the complete live filesystem.
 */
polkit.addRule(function(action, subject) {
    if (action.id == "io.calamares.calamares.pkexec.run" &&
        action.lookup("program") == "/usr/bin/calamares" &&
        subject.user == "liveuser" &&
        subject.local &&
        subject.active) {
        return polkit.Result.YES;
    }
});
