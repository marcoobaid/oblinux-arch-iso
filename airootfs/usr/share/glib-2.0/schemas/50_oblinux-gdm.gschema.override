# OBLinux GNOME defaults and GDM product-mark override.
#
# Same mechanism Arch's own gdm package uses for the default Arch logo
# (30_org.archlinux.gdm.gschema.override) — a GSettings schema override,
# compiled by glib-compile-schemas via the pacman hook glib2 already ships
# (usr/share/libalpm/hooks/glib-compile-schemas.hook). No custom build hook
# needed; numbered higher than Arch's own override so ours wins.
#
# Note: overriding org.gnome.desktop.background changes that schema's
# *compiled default*, used by any account that hasn't set its own
# wallpaper — this is how new user accounts (e.g. created by Calamares)
# get OBLinux's own default wallpaper instead of upstream GNOME's.
#
# GDM has its own dconf profile/database (etc/dconf/profile/gdm +
# etc/dconf/db/gdm.d/) which takes priority for the gdm user specifically,
# giving the greeter a Brand Master near-black-to-navy gradient rather than
# this picture-based desktop default. The desktop uses the established OBLinux
# Obsidian Horizon branded 3840x2160 JPEG for both appearance modes, preserving
# the repository's runtime-validated rule that GNOME backgrounds must not invoke
# the sandboxed SVG rendering path during live-session startup.
# The session lock screen is independent and remains on the same Brand Master
# dark PNG as an unlocked default, so users remain free to change it.

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/oblinux/oblinux-horizon-branded-3840x2160.jpg'
picture-uri-dark='file:///usr/share/backgrounds/oblinux/oblinux-horizon-branded-3840x2160.jpg'
picture-options='zoom'
primary-color='#111820'
secondary-color='#1B2836'
color-shading-type='solid'

[org.gnome.login-screen]
logo='/usr/share/pixmaps/oblinux-gdm-logo.png'

# Phase 2A: Brand Master lock-screen default. This is deliberately separate
# from org.gnome.desktop.background so the existing desktop wallpaper remains
# unchanged. The PNG is copied byte-for-byte from Brand Master v1.0.5; it is
# pre-rendered so the lock screen does not invoke GNOME's SVG loading pipeline.
[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/oblinux/oblinux-dark-3840x2160.png'
picture-options='zoom'
primary-color='#0B1118'
secondary-color='#0D2742'

# THEMING.md items 2+3: accent color and default fonts. Phase 3 aligns normal
# user sessions with the accepted Debian implementation's blue accent. GDM's
# dedicated dconf profile already selects the same blue value.
#
# accent-color: enum verified verbatim against gsettings-desktop-schemas
# upstream source (org.gnome.desktop.interface accent-color) — valid
# values are blue/teal/green/yellow/orange/red/pink/purple/slate;
# Phase 3 intentionally selects 'blue' for Debian parity.
#
# font-name / document-font-name: Inter (inter-font package, added to
# packages.x86_64), registered family confirmed via the package's own
# file list (usr/share/fonts/inter/Inter.ttc — the static family used
# here rather than the variable "Inter Variable" instance).
#
# monospace-font-name: JetBrains Mono, Nerd Font-patched — needed for
# starship/eza's icon glyphs to render instead of missing-glyph boxes.
# Vendored directly (airootfs/usr/share/fonts/OBLinux-jetbrains-mono-nerd/,
# not the ttf-jetbrains-mono-nerd package — see that directory's README
# and docs/THEMING.md item 1 for why). Uses the "Mono" build variant
# specifically (not the plain or "Propo" variant) so icon glyphs occupy a
# single fixed-width cell and don't break terminal column alignment.
# Registered family confirmed via fontTools name-table inspection of the
# vendored files: "JetBrainsMono Nerd Font Mono" (typographic family,
# name ID 16) — matches this value.
[org.gnome.desktop.interface]
accent-color='blue'
font-name='Inter 11'
document-font-name='Inter 11'
monospace-font-name='JetBrainsMono Nerd Font Mono 11'
# THEMING.md item 4: icon-theme='OBLinux' (oblinux-icon-theme package,
# github.com/marcoobaid/oblinux-icon-theme). Published via oblinux_repo
# and added to packages.x86_64 — see docs/CUSTOM_REPO.md for the
# build-order dependency this followed (same pattern as calamares/paru/
# ckbcomp).
icon-theme='OBLinux'

# Phase 3 follow-up: Ptyxis follows GNOME's light/dark system appearance by
# default, matching the accepted Debian behavior. This is an unlocked compiled
# default; an explicit per-user Light or Dark selection still takes precedence.
[org.gnome.Ptyxis]
interface-style='system'
